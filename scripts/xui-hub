#!/usr/bin/env bash
# xui-hub 管理命令(一键安装后在 /usr/local/bin/xui-hub):
#   xui-hub setup      构建并用 systemd 托管(install.sh 调用;重复执行安全)
#   xui-hub update     拉最新代码、重新构建、重启
#   xui-hub status     运行状态
#   xui-hub logs       实时日志(journalctl -f)
#   xui-hub restart | start | stop
#   xui-hub password   重设后台密码
#   xui-hub uninstall  停掉服务并删除(数据目录会问要不要保留)
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
SERVICE=xui-hub
RUN_USER=xuihub
ENV_FILE="$DIR/.env"
DATA_DIR="$DIR/data"
UNIT=/etc/systemd/system/$SERVICE.service

say() { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m错误:\033[0m %s\n' "$*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "请用 root 执行"; }
rand() { tr -dc 'A-Za-z0-9' </dev/urandom | head -c "${1:-16}"; }
env_get() { grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2-; }
# 改写 .env 里的一项(值里有 | & 等符号也没事):去掉旧行,追加新行,权限保持 root:xuihub 640
env_set() {
  { grep -vE "^$1=" "$ENV_FILE" 2>/dev/null || true; printf '%s=%s\n' "$1" "$2"; } >"$ENV_FILE.tmp"
  mv "$ENV_FILE.tmp" "$ENV_FILE"
  id "$RUN_USER" >/dev/null 2>&1 && chown root:"$RUN_USER" "$ENV_FILE"
  chmod 640 "$ENV_FILE"
}

# npm ci 失败多半是 better-sqlite3 没有预编译包要现编:补上编译工具再试一次
npm_ci() {
  (cd "$1" && npm ci --no-audit --no-fund --loglevel=error) && return 0
  say "依赖安装失败,安装编译工具后重试"
  apt-get install -y -qq build-essential python3 >/dev/null
  (cd "$1" && npm ci --no-audit --no-fund --loglevel=error)
}

build() {
  say "安装依赖并构建(首次要几分钟)"
  npm_ci "$DIR/server"
  npm_ci "$DIR/web"
  (cd "$DIR/web" && npm run build --silent)
  (cd "$DIR/server" && npm run build --silent && npm prune --omit=dev --no-audit --no-fund --loglevel=error)
}

write_env() {
  if [ ! -f "$ENV_FILE" ]; then
    cp "$DIR/.env.example" "$ENV_FILE"
    NEW_PASSWORD="$(rand 16)"
    env_set ADMIN_PASSWORD "$NEW_PASSWORD"
  elif [ -z "$(env_get ADMIN_PASSWORD)" ] || [ "$(env_get ADMIN_PASSWORD)" = change-me ]; then
    NEW_PASSWORD="$(rand 16)"
    env_set ADMIN_PASSWORD "$NEW_PASSWORD"
  fi
  chown root:"$RUN_USER" "$ENV_FILE"
  chmod 640 "$ENV_FILE"
}

write_unit() {
  local node
  node="$(command -v node)"
  cat >"$UNIT" <<UNIT
[Unit]
Description=xui-hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$RUN_USER
Group=$RUN_USER
WorkingDirectory=$DIR
EnvironmentFile=$ENV_FILE
Environment=NODE_ENV=production
Environment=DATA_DIR=$DATA_DIR
# .env 里的 LISTEN_ADDR / HOST_PORT 和 Docker 部署共用一套变量名
ExecStart=/bin/sh -c 'HOST="\${LISTEN_ADDR:-0.0.0.0}" PORT="\${HOST_PORT:-8788}" exec $node server/dist/index.js'
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=$DATA_DIR

[Install]
WantedBy=multi-user.target
UNIT
  systemctl daemon-reload
}

port() { echo "${HOST_PORT:-$(env_get HOST_PORT)}"; }

wait_healthy() {
  local p i
  p="$(port)"; p="${p:-8788}"
  for i in $(seq 1 30); do
    if curl -fsS -o /dev/null "http://127.0.0.1:$p/api/session" 2>/dev/null; then return 0; fi
    sleep 1
  done
  return 1
}

open_firewall() {
  local p
  p="$(port)"; p="${p:-8788}"
  if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active'; then
    ufw allow "$p"/tcp >/dev/null && say "ufw 已放行 $p/tcp"
  fi
}

public_ip() { curl -4fsS --max-time 5 https://api.ipify.org 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}'; }

setup() {
  need_root
  export DEBIAN_FRONTEND=noninteractive
  # 构建产物由 root 写、服务以 xuihub 读:别被 root 的 umask 077 坑了
  umask 022
  id "$RUN_USER" >/dev/null 2>&1 || useradd --system --home-dir "$DIR" --shell /usr/sbin/nologin "$RUN_USER"
  build
  mkdir -p "$DATA_DIR"
  chown -R "$RUN_USER:$RUN_USER" "$DATA_DIR"
  chmod 700 "$DATA_DIR"
  NEW_PASSWORD=""
  write_env
  write_unit
  ln -sfn "$DIR/scripts/xui-hub" /usr/local/bin/xui-hub
  systemctl enable -q "$SERVICE"
  systemctl restart "$SERVICE"
  if wait_healthy; then
    open_firewall
    local p
    p="$(port)"; p="${p:-8788}"
    echo
    say "xui-hub 已启动"
    echo "  后台地址:http://$(public_ip):$p"
    if [ -n "$NEW_PASSWORD" ]; then
      echo "  后台密码:$NEW_PASSWORD   (已写入 $ENV_FILE,改密码用 xui-hub password)"
    else
      echo "  后台密码:沿用 $ENV_FILE 里的 ADMIN_PASSWORD"
    fi
    echo "  常用命令:xui-hub status | logs | update | password"
    echo "  云服务器记得在安全组里放行 $p/tcp"
  else
    systemctl status "$SERVICE" --no-pager || true
    journalctl -u "$SERVICE" -n 30 --no-pager || true
    die "服务没有在 30 秒内就绪,看上面的日志"
  fi
}

update() {
  need_root
  say "拉取最新代码"
  local before after
  before="$(git -C "$DIR" rev-parse HEAD)"
  git -C "$DIR" pull -q --ff-only
  after="$(git -C "$DIR" rev-parse HEAD)"
  if [ "$before" = "$after" ]; then echo "代码已是最新:$(git -C "$DIR" log --oneline -1)"; else git -C "$DIR" log --oneline "$before..$after"; fi
  setup
}

password() {
  need_root
  local pw
  read -r -s -p "新的后台密码(直接回车则随机生成):" pw; echo
  [ -n "$pw" ] || pw="$(rand 16)"
  env_set ADMIN_PASSWORD "$pw"
  systemctl restart "$SERVICE"
  say "密码已更新:$pw"
}

uninstall() {
  need_root
  read -r -p "停掉并删除 xui-hub 服务?[y/N] " yn
  [ "$yn" = y ] || [ "$yn" = Y ] || exit 0
  systemctl disable --now "$SERVICE" 2>/dev/null || true
  rm -f "$UNIT" /usr/local/bin/xui-hub
  systemctl daemon-reload
  read -r -p "连同 $DIR(含数据库 $DATA_DIR)一起删除?[y/N] " yn
  if [ "$yn" = y ] || [ "$yn" = Y ]; then rm -rf "$DIR"; say "已删除 $DIR"; else say "保留了 $DIR"; fi
  userdel "$RUN_USER" 2>/dev/null || true
  say "已卸载"
}

case "${1:-}" in
  setup) setup ;;
  update) update ;;
  status) systemctl status "$SERVICE" --no-pager ;;
  logs) journalctl -u "$SERVICE" -f -n 100 ;;
  restart | start | stop) need_root; systemctl "$1" "$SERVICE"; systemctl status "$SERVICE" --no-pager | head -5 ;;
  password) password ;;
  uninstall) uninstall ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
