# 复制为 .env 并修改。.env 不要提交到 git。

# 后台登录密码(容器内监听 0.0.0.0,必须设置)
ADMIN_PASSWORD=change-me

# 公网访问的域名(A 记录指向本机),启用 caddy 时必填
# DOMAIN=admin.example.com

# 订阅专用域名(逗号分隔):只提供订阅(/sub/<token>),后台与其他路径 404;经 Cloudflare Tunnel 回源
# SUB_DOMAINS=sub.example.com

# Cloudflare Tunnel 的 token(订阅域名经隧道回源);同时在 COMPOSE_PROFILES 里加上 tunnel
# CF_TUNNEL_TOKEN=

# 订阅链接的域名(不填则后台生成不了订阅链接)。走 Cloudflare Tunnel 时和 SUB_DOMAINS 一致
# SUB_BASE_URL=https://sub.example.com

# Clash 输出补 Mihomo 基础模板(dns / tcp-concurrent / unified-delay)的范围:all、逗号分隔的客户名(灰度),空 = 关闭
# MIHOMO_TEMPLATE=all

# 同步间隔(秒)与并发面板数
# SYNC_INTERVAL_SEC=60
# SYNC_CONCURRENCY=8

# 流量历史(每小时流量、计数回退记录)保留天数
# HISTORY_DAYS=60

# 每天自动备份数据库;data/backups 里超过这么多天的备份、面板配置快照删掉(每台面板最近 10 份快照总会留着)
# BACKUP_KEEP_DAYS=7

# 异地备份(可选):每天的数据库备份 gzip 后再上传一份到 S3 兼容的对象存储,如 Cloudflare R2。四项都填才启用。
# 远端只上传不删,保留多久在存储桶的生命周期规则里设。R2 的 ENDPOINT 是 https://<账号 ID>.r2.cloudflarestorage.com
# (R2 存储桶设置页显示的 S3 API 地址末尾带着桶名,照抄也行)
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto

# 订阅拉取记录保留天数
# SUB_LOG_DAYS=7

# 按天汇总用量的时区偏移(分钟),默认 UTC+8
# TZ_OFFSET_MIN=480
