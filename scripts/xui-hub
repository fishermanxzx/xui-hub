#!/usr/bin/env bash
# xui-hub 管理脚本(安装后在 /usr/bin/xui-hub)。不带参数进菜单,也可以直接用子命令:
#   xui-hub status | log | start | stop | restart | enable | disable
#   xui-hub update [版本]   更新(默认最新版)      xui-hub install     重新安装
#   xui-hub password        重设后台密码          xui-hub port        改后台端口
#   xui-hub settings        当前设置              xui-hub uninstall   卸载
#   xui-hub ssl             SSL 证书管理菜单(xui-hub ssl ip | domain <域名> | cf <域名> 可直接执行)
#   xui-hub backup [目录]   备份数据库            xui-hub restore <文件>  恢复备份
set -uo pipefail

REPO="${XUIHUB_REPO:-fishermanxzx/xui-hub}"
DIR=/usr/local/xui-hub
ETC=/etc/xui-hub
ENV_FILE="$ETC/.env"
SERVICE=xui-hub
RUN_USER=xuihub
CERT_DIR="$ETC/cert"
ACME="$HOME/.acme.sh/acme.sh"

red='\033[0;31m'; green='\033[0;32m'; yellow='\033[0;33m'; plain='\033[0m'
ok() { echo -e "${green}$*${plain}"; }
warn() { echo -e "${yellow}$*${plain}"; }
err() { echo -e "${red}$*${plain}" >&2; }
need_root() { [ "$(id -u)" = 0 ] || { err "请用 root 执行"; exit 1; }; }
rand() { head -c 256 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | cut -c1-"${1:-16}"; }
# .env 里的值:带特殊字符的用单引号包起来(systemd 的 EnvironmentFile 和 docker 的 env_file 都把单引号里的内容原样读);读的时候去掉引号
env_quote() { case "$1" in *[!A-Za-z0-9_./:@%+=,-]*) printf "'%s'" "$1" ;; *) printf '%s' "$1" ;; esac; }
env_get() {
  local v
  v="$(grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2-)" || true
  case "$v" in \'*\') v="${v#\'}"; v="${v%\'}" ;; \"*\") v="${v#\"}"; v="${v%\"}" ;; esac
  printf '%s\n' "$v"
}
# 单引号包不住单引号自己,密码里不能有
pw_ok() { case "$1" in *\'*) return 1 ;; esac; }
env_set() {
  { grep -vE "^$1=" "$ENV_FILE" 2>/dev/null || true; printf '%s=%s\n' "$1" "$(env_quote "$2")"; } >"$ENV_FILE.tmp"
  mv "$ENV_FILE.tmp" "$ENV_FILE"
  chown root:"$RUN_USER" "$ENV_FILE" 2>/dev/null
  chmod 640 "$ENV_FILE"
}
env_unset() {
  local pat
  pat="$(IFS='|'; echo "$*")"
  { grep -vE "^($pat)=" "$ENV_FILE" 2>/dev/null || true; } >"$ENV_FILE.tmp"
  mv "$ENV_FILE.tmp" "$ENV_FILE"
  chown root:"$RUN_USER" "$ENV_FILE" 2>/dev/null
  chmod 640 "$ENV_FILE"
}
confirm() {
  local yn
  read -r -p "$1 [y/N] " yn
  [ "$yn" = y ] || [ "$yn" = Y ]
}
installed() { [ -f "$DIR/server/dist/index.js" ] && [ -f /etc/systemd/system/$SERVICE.service ]; }
check_install() { installed || { err "xui-hub 还没安装,先执行 xui-hub install"; return 1; }; }
version() { cat "$DIR/VERSION" 2>/dev/null || echo 未知; }
port() { local p; p="$(env_get HOST_PORT)"; echo "${p:-8788}"; }
scheme() { [ -n "$(env_get TLS_CERT_FILE)" ] && echo https || echo http; }
is_domain() { [[ "$1" =~ ^([A-Za-z0-9](-*[A-Za-z0-9])*\.)+[A-Za-z]{2,}$ ]]; }
is_ipv4() { [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; }
# 只监听某一个地址时返回它;没设或设成通配(所有网卡都听)返回空
listen_addr() {
  local a
  a="$(env_get LISTEN_ADDR)"
  case "$a" in 0.0.0.0 | ::) a="" ;; esac
  printf '%s\n' "$a"
}
# 写进 URL 的主机名:IPv6 要加方括号
url_host() { case "$1" in *:*) echo "[$1]" ;; *) echo "$1" ;; esac; }

# 出口公网 IPv4,问不到就返回失败
public_ipv4() {
  local u ip
  for u in https://api4.ipify.org https://ipv4.icanhazip.com https://4.ident.me; do
    ip="$(curl -4fsS --max-time 3 "$u" 2>/dev/null | tr -d '[:space:]')"
    if is_ipv4 "$ip"; then echo "$ip"; return 0; fi
  done
  return 1
}
public_ip() { public_ipv4 || hostname -I 2>/dev/null | awk '{print $1}'; }
# 这个 IPv4 是不是本机的:网卡上有,或者就是出口公网 IP(公网 IP 问不到时不下结论,当它是)
ip_is_local() {
  local pub
  hostname -I 2>/dev/null | tr ' ' '\n' | grep -Fx "$1" >/dev/null && return 0
  pub="$(public_ipv4)" || return 0
  [ "$pub" = "$1" ]
}

# ---- 后台地址 ----
# 证书签给的名字(SAN),一行一个。只认域名和 IP,email / URI / DirName 这些不是访问地址
cert_names() {
  [ -f "$1" ] || return 1
  openssl x509 -in "$1" -noout -ext subjectAltName 2>/dev/null |
    awk -F, '{ for (i = 1; i <= NF; i++) { t = $i; sub(/^ +/, "", t); if (sub(/^DNS:/, "", t) || sub(/^IP Address:/, "", t)) print t } }'
}
# 证书是不是签给了这个名字(域名按通配符规则算)。看输出不看退出码:OpenSSL 1.1 不管符不符都返回 0
cert_covers() {
  local f="$1" h="$2" flag=-checkhost
  [ -f "$f" ] && [ -n "$h" ] || return 1
  case "$h" in *:*) flag=-checkip ;; esac
  is_ipv4 "$h" && flag=-checkip
  openssl x509 -in "$f" -noout "$flag" "$h" 2>/dev/null | grep 'does match' >/dev/null
}
# 这个名字能不能当后台地址:回环不行;IPv4 得是本机的(机器换过 IP 的话,旧 IP 证书里的地址已经连不到这里)
host_usable() {
  case "$1" in "" | localhost | 127.* | ::1 | 0:0:0:0:0:0:0:1) return 1 ;; esac
  ! is_ipv4 "$1" || ip_is_local "$1"
}
# 从证书里挑一个能当地址的名字。通配符条目跳过:*.example.com 不含 example.com 本身,具体用哪个子域名猜不出来
cert_host() {
  local n
  while read -r n; do
    case "$n" in \*.*) continue ;; esac
    if host_usable "$n"; then printf '%s\n' "$n"; return 0; fi
  done < <(cert_names "$1")
  return 1
}
# 后台地址里的主机名,依次取:
#   PANEL_HOST(设证书时记下的访问域名 / IP;证书换了、不再签给它就不算)→ 从证书里挑 → 只监听某个地址时就是它 → 公网 IP
panel_host() {
  local cert h
  cert="$(env_get TLS_CERT_FILE)"
  h="$(env_get PANEL_HOST)"
  if host_usable "$h" && { [ -z "$cert" ] || cert_covers "$cert" "$h"; }; then printf '%s\n' "$h"; return; fi
  if [ -n "$cert" ] && cert_host "$cert"; then return; fi
  h="$(listen_addr)"
  if [ -n "$h" ]; then printf '%s\n' "$h"; return; fi
  public_ip
}
panel_url() {
  local h
  h="$(panel_host)"
  echo "$(scheme)://$(url_host "${h:-<服务器 IP>}"):$(port)"
}
# 开了 HTTPS、但证书不是签给上面那个地址的(通配符证书、换过 IP 的 IP 证书):浏览器会报证书不符,说清楚怎么办
cert_mismatch_hint() {
  local cert h
  cert="$(env_get TLS_CERT_FILE)"
  [ -n "$cert" ] || return 0
  h="$(panel_host)"
  cert_covers "$cert" "$h" && return 0
  warn "  证书没有签给 $h(证书里的名字:$(cert_names "$cert" | paste -sd' ' -)),按这个地址打开浏览器会报证书不符"
  warn "  要用证书里的域名访问,在 $ENV_FILE 里加一行 PANEL_HOST=<域名>;机器换了 IP 就重新申请:xui-hub ssl ip"
}

# 后台端口在 1024 以下时,服务(不是 root)要有 CAP_NET_BIND_SERVICE 才绑得上。只在用到时用 drop-in 加上:
# 写死在单元里的话,不支持 ambient capabilities 的环境(很老的内核、部分容器)上服务会直接起不来,哪怕用的是默认端口
DROPIN=/etc/systemd/system/$SERVICE.service.d/low-port.conf
sync_port_cap() {
  local want=0 have=0
  [ "$(port)" -lt 1024 ] 2>/dev/null && want=1
  [ -f "$DROPIN" ] && have=1
  [ "$want" = "$have" ] && return 0
  if [ "$want" = 1 ]; then
    mkdir -p "${DROPIN%/*}"
    printf '[Service]\nAmbientCapabilities=CAP_NET_BIND_SERVICE\n' >"$DROPIN"
  else
    rm -f "$DROPIN"
    rmdir "${DROPIN%/*}" 2>/dev/null
  fi
  systemctl daemon-reload
}

# 脚本自己重启服务时先清掉 systemd 记的失败次数:配置有问题让服务反复崩溃后,启动次数限额(3 分钟 10 次)可能已经用完,
# 不清的话,连改回正确配置后的那次重启都会被拒绝(start-limit-hit),后台就一直起不来
svc_restart() {
  sync_port_cap
  systemctl reset-failed "$SERVICE" 2>/dev/null
  systemctl restart "$SERVICE"
}

# 重启后等服务真的能应答。systemctl restart 对 Type=simple 的服务总是成功,端口绑不上、证书读不到都是进程起来之后才崩;
# 连的是服务实际监听的地址(LISTEN_ADDR 写了具体地址时,127.0.0.1 上没人听)
wait_up() {
  local a i
  a="$(listen_addr)"
  for ((i = 0; i < 15; i++)); do
    curl -fsSk -o /dev/null --max-time 3 "$(scheme)://$(url_host "${a:-127.0.0.1}"):$(port)/api/session" 2>/dev/null && return 0
    # 已经崩了又被 systemd 拉起来两回,不用等满
    [ "$(systemctl show "$SERVICE" -p NRestarts --value 2>/dev/null)" -ge 2 ] 2>/dev/null && return 1
    sleep 1
  done
  return 1
}

run_installer() {
  need_root
  local tmp
  tmp="$(mktemp)"
  # 带时间戳绕过 raw.githubusercontent.com 的 CDN 缓存(最长 5 分钟),刚修的安装脚本马上能用上
  curl -fsSL "https://raw.githubusercontent.com/$REPO/main/install.sh?t=$(date +%s)" -o "$tmp" || { err "下载安装脚本失败,检查能否访问 GitHub"; rm -f "$tmp"; return 1; }
  XUIHUB_NONINTERACTIVE="${XUIHUB_NONINTERACTIVE:-0}" bash "$tmp" "$@"
  local rc=$?
  rm -f "$tmp"
  return $rc
}

install() { run_installer "$@"; }
update() { check_install && run_installer "$@"; }

uninstall() {
  need_root; check_install || return 1
  confirm "停掉并删除 xui-hub 程序?" || return 0
  systemctl disable --now "$SERVICE" "$SERVICE-subconverter" 2>/dev/null
  rm -f /etc/systemd/system/$SERVICE.service /etc/systemd/system/$SERVICE-subconverter.service "$DROPIN" /usr/bin/xui-hub
  rmdir "${DROPIN%/*}" 2>/dev/null
  systemctl daemon-reload
  rm -rf "$DIR"
  if confirm "连同数据目录 $ETC(数据库和 .env)一起删除?"; then rm -rf "$ETC"; ok "已删除 $ETC"; else ok "保留了 $ETC"; fi
  userdel "$RUN_USER" 2>/dev/null
  ok "已卸载"
  # 申请过证书的话,acme.sh 的自动续期还在(续完会去重启一个已经不存在的服务,只是报个错)
  if [ -x "$ACME" ] && [ -n "$("$ACME" --list 2>/dev/null | awk 'NR>1')" ]; then
    warn "acme.sh 里的证书还在自动续期,不要了就逐个删掉:$ACME --remove -d <域名或 IP> --ecc($ACME --list 看有哪些)"
  fi
}

password() {
  need_root; check_install || return 1
  local pw
  read -r -s -p "新的后台密码(直接回车随机生成):" pw; echo
  pw_ok "$pw" || { err "密码里不能有单引号"; return 1; }
  env_set ADMIN_PASSWORD "${pw:-$(rand 16)}"
  svc_restart
  wait_up || { err "密码已经写进 $ENV_FILE,但 xui-hub 没起来,看日志:xui-hub log"; return 1; }
  # 自己输的不回显;随机生成的打出来(之前登录着的设备都要重新登录)
  if [ -n "$pw" ]; then ok "密码已更新"; else ok "密码已更新:$(env_get ADMIN_PASSWORD)"; fi
}

# 开着的是哪种防火墙(都没开就什么也不输出)。管道里不用 grep -q:它匹配到就退出,上游被 SIGPIPE 打断,pipefail 下整条算失败
firewall_kind() {
  if command -v ufw >/dev/null && ufw status 2>/dev/null | grep '^Status: active' >/dev/null; then
    echo ufw
  elif command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
    echo firewalld
  fi
}
# 放行端口:ufw 或 firewalld 开着才动(和安装时一致)
open_firewall() {
  local p="$1"
  case "$(firewall_kind)" in
    ufw) if ufw allow "$p"/tcp >/dev/null; then ok "ufw 已放行 $p/tcp"; else warn "ufw 放行 $p/tcp 失败,自己放行一下:ufw allow $p/tcp"; fi ;;
    firewalld) if firewall-cmd -q --permanent --add-port="$p"/tcp && firewall-cmd -q --reload; then ok "firewalld 已放行 $p/tcp"; else warn "firewalld 放行 $p/tcp 失败,自己放行一下:firewall-cmd --permanent --add-port=$p/tcp && firewall-cmd --reload"; fi ;;
  esac
  return 0
}

set_port() {
  need_root; check_install || return 1
  local p old
  old="$(port)"
  read -r -p "新的后台端口 [$old]:" p
  p="${p:-$old}"
  [[ "$p" =~ ^[0-9]+$ ]] && [ "$p" -ge 1 ] && [ "$p" -le 65535 ] || { err "端口不合法"; return 1; }
  [ "$p" != "$old" ] || { echo "端口没变,还是 $old"; return 0; }
  port_in_use "$p" && { err "端口 $p 已经被别的程序占用(ss -ltnp 看是谁),换一个"; return 1; }
  env_set HOST_PORT "$p"
  svc_restart
  if ! wait_up; then
    err "换到 $p 端口后 xui-hub 没起来,已改回 $old。日志:"
    journalctl -u "$SERVICE" -n 10 --no-pager
    env_set HOST_PORT "$old"
    svc_restart
    return 1
  fi
  open_firewall "$p"
  ok "端口已改为 $p,后台地址 $(panel_url)(云服务器记得放行安全组)"
  # 旧端口的放行规则不替用户收回(它可能另有用处,比如把 443 让给网站),只说一声
  case "$(firewall_kind)" in
    ufw) echo "  旧端口 $old 的放行规则还留着,不用了可以收回:ufw delete allow $old/tcp" ;;
    firewalld) echo "  旧端口 $old 的放行规则还留着,不用了可以收回:firewall-cmd --permanent --remove-port=$old/tcp && firewall-cmd --reload" ;;
  esac
}

settings() {
  need_root; check_install || return 1
  local la
  echo "版本:$(version)"
  echo "后台地址:$(panel_url)"
  cert_mismatch_hint
  if [ -n "$(env_get TLS_CERT_FILE)" ]; then echo "HTTPS 证书:$(env_get TLS_CERT_FILE)($(cert_summary "$(env_get TLS_CERT_FILE)"))"; else echo "HTTPS:未开启(xui-hub ssl 可申请证书)"; fi
  la="$(listen_addr)"
  case "$la" in
    127.* | ::1 | localhost) echo "监听地址:$la(只听本机,外面要经反向代理访问)" ;;
    *) echo "监听地址:${la:-0.0.0.0}" ;;
  esac
  echo "程序目录:$DIR"
  echo "数据目录:$ETC(hub.db、.env)"
  echo "配置文件:$ENV_FILE"
  cat "$DIR/BUILD" 2>/dev/null | sed 's/^/  /'
}

svc() {
  need_root
  case "$1" in start | restart) sync_port_cap; systemctl reset-failed "$SERVICE" 2>/dev/null ;; esac
  systemctl "$1" "$SERVICE-subconverter" 2>/dev/null
  systemctl "$1" "$SERVICE" && show_status
}

# ======================= 备份 / 恢复 =======================
# 备份用 SQLite 在线备份(服务不用停,WAL 里的也带上);恢复先停服务再换文件,旧库留一份 .bak
backup() {
  need_root; check_install || return 1
  local dest="${1:-$ETC/backup}" file
  mkdir -p "$dest"
  file="$dest/xui-hub-$(date +%Y%m%d-%H%M).db"
  (cd "$DIR/server" && "$DIR/bin/node" -e "require('better-sqlite3')(process.argv[1],{readonly:true}).backup(process.argv[2]).then(()=>process.exit(0),e=>{console.error(e.message);process.exit(1)})" "$ETC/hub.db" "$file") || { err "备份失败"; return 1; }
  chmod 600 "$file"
  ok "已备份到 $file($(du -h "$file" | cut -f1))"
  # 最多留 30 份
  ls -1t "$dest"/xui-hub-*.db 2>/dev/null | tail -n +31 | xargs -r rm -f
}

restore() {
  need_root; check_install || return 1
  local file="${1:-}"
  [ -n "$file" ] || { echo "用法:xui-hub restore <备份文件.db>"; ls -1t "$ETC/backup"/xui-hub-*.db 2>/dev/null | head -n 10 | sed 's/^/  /'; return 1; }
  [ -f "$file" ] || { err "文件不存在:$file"; return 1; }
  [ "$(head -c 15 "$file")" = "SQLite format 3" ] || { err "这不是 SQLite 数据库文件"; return 1; }
  confirm "用 $file 替换当前数据库?现在的面板、客户、线路都会变成备份里的内容(旧库留在 $ETC/hub.db.bak-*)" || return 0
  systemctl stop "$SERVICE"
  [ -f "$ETC/hub.db" ] && mv "$ETC/hub.db" "$ETC/hub.db.bak-$(date +%Y%m%d-%H%M%S)"
  rm -f "$ETC/hub.db-wal" "$ETC/hub.db-shm"
  cp "$file" "$ETC/hub.db"; chown "$RUN_USER:$RUN_USER" "$ETC/hub.db"; chmod 600 "$ETC/hub.db"
  svc_restart
  if wait_up; then ok "已恢复,服务已重启(登录状态会失效,重新登录即可)"; else err "服务没起来:xui-hub log"; fi
}

# ======================= SSL 证书(照 x-ui 的做法:acme.sh + Let's Encrypt) =======================
cert_summary() {
  local f="$1" issuer end
  [ -f "$f" ] || { echo "文件不存在"; return; }
  issuer="$(openssl x509 -in "$f" -noout -issuer 2>/dev/null | sed 's/.*O *= *\([^,]*\).*/\1/')"
  end="$(openssl x509 -in "$f" -noout -enddate 2>/dev/null | cut -d= -f2)"
  echo "签发:${issuer:-?},到期:${end:-?}"
}

install_acme() {
  [ -x "$ACME" ] && return 0
  ok "安装 acme.sh"
  # HTTP-01 验证要用 socat,自动续期要用 cron
  if command -v apt-get >/dev/null; then DEBIAN_FRONTEND=noninteractive apt-get install -y -qq socat cron openssl >/dev/null 2>&1
  elif command -v dnf >/dev/null; then dnf install -y -q socat cronie openssl >/dev/null 2>&1
  elif command -v yum >/dev/null; then yum install -y -q socat cronie openssl >/dev/null 2>&1
  elif command -v pacman >/dev/null; then pacman -Sy --noconfirm --needed socat cronie openssl >/dev/null 2>&1
  elif command -v zypper >/dev/null; then zypper -q install -y socat cron openssl >/dev/null 2>&1
  fi
  (cd "$HOME" && curl -fsSL https://get.acme.sh | sh -s >/dev/null 2>&1) || { err "acme.sh 安装失败"; return 1; }
  [ -x "$ACME" ] || { err "acme.sh 安装失败"; return 1; }
  "$ACME" --set-default-ca --server letsencrypt >/dev/null 2>&1
}

port_in_use() { [ -n "$(ss -ltn 2>/dev/null | awk -v p="$1" '$4 ~ ("[:.]" p "$")')" ]; }

# acme.sh 的证书状态目录(申请失败时清掉,否则下次会沿用坏状态)
acme_state_rm() { local id="${1:?}"; rm -rf "${HOME:?}/.acme.sh/${id}" "${HOME:?}/.acme.sh/${id}_ecc"; }

# 把 acme.sh 里的证书装到 $CERT_DIR/<名字>/,续期后自动重启 xui-hub;服务用户要能读
install_cert_files() {
  local id="$1" name="$2" dir="$CERT_DIR/$2"
  mkdir -p "$dir"
  "$ACME" --install-cert -d "$id" --ecc --fullchain-file "$dir/fullchain.pem" --key-file "$dir/privkey.pem" --reloadcmd "xui-hub restart" >/dev/null 2>&1 ||
    "$ACME" --install-cert -d "$id" --fullchain-file "$dir/fullchain.pem" --key-file "$dir/privkey.pem" --reloadcmd "xui-hub restart" >/dev/null 2>&1 || true
  [ -s "$dir/fullchain.pem" ] && [ -s "$dir/privkey.pem" ] || { err "证书文件没有写出来"; return 1; }
  chown -R root:"$RUN_USER" "$CERT_DIR"
  chmod 750 "$CERT_DIR" "$dir"
  chmod 640 "$dir/privkey.pem"
  chmod 644 "$dir/fullchain.pem"
  "$ACME" --upgrade --auto-upgrade >/dev/null 2>&1 || true
  echo "$dir"
}

# 把一对证书文件设给 xui-hub:写 .env(连同访问用的域名 / IP,之后显示后台地址就用它)并重启;
# 起不来就改回原来的设置,不留下一个打不开的后台
set_tls() {
  local cf="$1" kf="$2" host="$3" old_cf old_kf old_host
  old_cf="$(env_get TLS_CERT_FILE)"; old_kf="$(env_get TLS_KEY_FILE)"; old_host="$(env_get PANEL_HOST)"
  env_set TLS_CERT_FILE "$cf"
  env_set TLS_KEY_FILE "$kf"
  if [ -n "$host" ]; then env_set PANEL_HOST "$host"; else env_unset PANEL_HOST; fi
  svc_restart
  if wait_up; then
    ok "xui-hub 已切到 HTTPS:$(panel_url)"
    is_domain "$host" && echo "  确认域名 $host 已解析到本机 $(public_ip)"
    cert_mismatch_hint
    return 0
  fi
  err "换上这张证书后 xui-hub 没起来,已改回原来的设置。日志:"
  journalctl -u "$SERVICE" -n 10 --no-pager
  if [ -n "$old_cf" ]; then env_set TLS_CERT_FILE "$old_cf"; env_set TLS_KEY_FILE "$old_kf"; else env_unset TLS_CERT_FILE TLS_KEY_FILE; fi
  if [ -n "$old_host" ]; then env_set PANEL_HOST "$old_host"; else env_unset PANEL_HOST; fi
  svc_restart
  return 1
}

# 用 $CERT_DIR 下的一张证书。没给访问地址就从证书里取(目录名不一定是域名,IP 证书的目录叫 ip)
use_cert() {
  local dir="$1" host="${2:-}"
  [ -n "$host" ] || host="$(cert_host "$dir/fullchain.pem")"
  set_tls "$dir/fullchain.pem" "$dir/privkey.pem" "$host"
}

# 服务看不看得到这个路径:单元开了 ProtectHome / PrivateTmp,/root、/home、/tmp 下的文件对它不存在,改权限也没用
hidden_from_service() {
  local real
  real="$(readlink -f "$1" 2>/dev/null)"
  case "${real:-$1}" in
    /root/* | /home/* | /run/user/*) [ "$(systemctl show "$SERVICE" -p ProtectHome 2>/dev/null)" != ProtectHome=no ] ;;
    /tmp/* | /var/tmp/*) [ "$(systemctl show "$SERVICE" -p PrivateTmp 2>/dev/null)" != PrivateTmp=no ] ;;
    *) return 1 ;;
  esac
}

ask_use_cert() {
  local dir="$1" host="$2" yn
  if [ "${XUIHUB_NONINTERACTIVE:-0}" = 1 ]; then use_cert "$dir" "$host"; return; fi
  read -r -p "把这张证书设为 xui-hub 的 HTTPS 证书?[Y/n] " yn
  [ "$yn" = n ] || [ "$yn" = N ] || use_cert "$dir" "$host"
}

# 跑 acme.sh --issue:先说要等多久(期间 acme.sh 没有输出,不提示会像卡死),失败时把 acme.sh 自己的报错打出来
# 用法:acme_issue "<等待提示>" <acme.sh --issue 之后的参数…>
acme_issue() {
  local hint="$1" out rc=0; shift
  echo "  $hint,期间没有输出是正常的,不要按 Ctrl+C…"
  out="$("$ACME" --issue "$@" --server letsencrypt --keylength ec-256 --force 2>&1)" || rc=$?
  case "$out" in *"Cert success"*) return 0 ;; esac
  err "acme.sh 的报错(退出码 $rc):"
  acme_errors "$out"
  return 1
}
# 从 acme.sh 的输出里只挑报错相关的行(挑不出就给最后几行);万一带出 Token 就遮掉
acme_errors() {
  { printf '%s\n' "$1" | grep -iE "error|invalid|fail|denied|unauthorized|rate ?limit|timeout|not found|refused|detail" || printf '%s\n' "$1" | tail -n 8; } |
    tail -n 12 | sed -e "s/${CF_Token:-__no_token__}/***/g" -e 's/^\[[^]]*\] */    /' >&2
}
ssl_issue_ip() {
  need_root; install_acme || return 1
  local ip="${1:-$(public_ip)}" a
  if [ "${XUIHUB_NONINTERACTIVE:-0}" != 1 ] && [ -z "${1:-}" ]; then
    read -r -p "给哪个公网 IPv4 申请证书 [$ip]:" a; ip="${a:-$ip}"
  fi
  is_ipv4 "$ip" || { err "IP 不合法:$ip"; return 1; }
  port_in_use 80 && { err "80 端口被占用,Let's Encrypt 要从 80 端口验证;先停掉占用的服务再试"; return 1; }
  warn "Let's Encrypt 给 IP 签的证书只有 6 天有效期,acme.sh 的 cron 会自动续,续完自动重启 xui-hub"
  ok "申请 $ip 的证书(HTTP-01,监听 80)"
  if ! acme_issue "正在验证并签发,一般不到 1 分钟" --standalone -d "$ip" --certificate-profile shortlived --days 6; then
    err "申请失败:确认 80 端口能从公网访问(安全组 / 防火墙)"; acme_state_rm "$ip"; return 1
  fi
  local dir; dir="$(install_cert_files "$ip" ip)" || return 1
  ok "证书已装到 $dir($(cert_summary "$dir/fullchain.pem"))"
  ask_use_cert "$dir" "$ip"
}

ssl_issue_domain() {
  need_root; install_acme || return 1
  local domain="${1:-}"
  while ! is_domain "$domain"; do
    [ "${XUIHUB_NONINTERACTIVE:-0}" = 1 ] && { err "域名不合法:$domain"; return 1; }
    read -r -p "域名(A 记录已指向本机):" domain
  done
  port_in_use 80 && { err "80 端口被占用,HTTP-01 验证要用 80;先停掉占用的服务,或用 xui-hub ssl cf 走 Cloudflare DNS 验证"; return 1; }
  ok "申请 $domain 的证书(HTTP-01,监听 80)"
  if ! acme_issue "正在验证并签发,一般不到 1 分钟" --standalone -d "$domain"; then
    err "申请失败:确认域名已解析到本机、80 端口能从公网访问"; acme_state_rm "$domain"; return 1
  fi
  local dir; dir="$(install_cert_files "$domain" "$domain")" || return 1
  ok "证书已装到 $dir($(cert_summary "$dir/fullchain.pem")),acme.sh 会自动续期"
  ask_use_cert "$dir" "$domain"
}

ssl_issue_cf() {
  need_root; install_acme || return 1
  local domain="${1:-}" token="${CF_Token:-}"
  while ! is_domain "$domain"; do
    [ "${XUIHUB_NONINTERACTIVE:-0}" = 1 ] && { err "域名不合法:$domain"; return 1; }
    read -r -p "域名(会同时签 *.域名 通配符):" domain
  done
  if [ -z "$token" ]; then
    [ "${XUIHUB_NONINTERACTIVE:-0}" = 1 ] && { err "非交互模式要用环境变量 CF_Token 传 Cloudflare API Token"; return 1; }
    read -r -s -p "Cloudflare API Token(权限 Zone:DNS:Edit):" token; echo
  fi
  [ -n "$token" ] || { err "Token 不能为空"; return 1; }
  export CF_Token="$token"
  ok "申请 $domain 和 *.$domain 的证书(Cloudflare DNS 验证,不需要开 80)"
  if ! acme_issue "正在加 DNS 记录、等它生效再签发,大约要 1-3 分钟" --dns dns_cf -d "$domain" -d "*.$domain"; then
    err "申请失败:检查 Token(要「API 令牌」,权限 Zone:DNS:Edit,区域包含这个域名)以及域名是否托管在这个 Cloudflare 账号下"
    err "域名不在自己的 Cloudflare 账号里就用 xui-hub ssl domain(HTTP-01)或 xui-hub ssl ip"; acme_state_rm "$domain"; return 1
  fi
  local dir; dir="$(install_cert_files "$domain" "$domain")" || return 1
  ok "证书已装到 $dir($(cert_summary "$dir/fullchain.pem")),acme.sh 会自动续期"
  ask_use_cert "$dir" "$domain"
}

ssl_list() {
  local d found=0
  for d in "$CERT_DIR"/*/; do
    [ -d "$d" ] || continue
    found=1
    echo "$(basename "$d"):${d%/}"
    echo "  $(cert_summary "$d/fullchain.pem")"
  done
  [ $found = 1 ] || echo "$CERT_DIR 下还没有证书"
  local cur; cur="$(env_get TLS_CERT_FILE)"
  if [ -n "$cur" ]; then echo "xui-hub 正在用:$cur($(cert_summary "$cur"))"; else echo "xui-hub 目前是 HTTP"; fi
}

# acme.sh 里对应的记录名:域名就是域名,ip 目录对应签的那个 IP
acme_id_of() { if [ "$1" = ip ]; then "$ACME" --list 2>/dev/null | awk 'NR>1 {print $1}' | grep -E '^[0-9.]+$' | sed -n 1p; else echo "$1"; fi; }

pick_cert_name() {
  local names name; names="$(ls -1 "$CERT_DIR" 2>/dev/null)"
  [ -n "$names" ] || { err "还没有证书"; return 1; }
  echo "$names" | sed 's/^/  /' >&2
  read -r -p "选哪一个(输入名字):" name
  # 名字只能是目录下的一项(后面会按它删目录,不能让 .. 或带 / 的混进来)
  case "$name" in "" | . | .. | */*) err "没有这个证书"; return 1 ;; esac
  [ -d "$CERT_DIR/$name" ] || { err "没有这个证书"; return 1; }
  echo "$name"
}

ssl_renew() {
  need_root; [ -x "$ACME" ] || { err "acme.sh 没装,没有可续的证书"; return 1; }
  local name id out rc=0; name="$(pick_cert_name)" || return 1
  id="$(acme_id_of "$name")"
  [ -n "$id" ] || { err "acme.sh 里没有 $name 对应的证书记录,续不了"; return 1; }
  echo "  正在续期,一般不到 1 分钟,期间没有输出是正常的,不要按 Ctrl+C…"
  out="$("$ACME" --renew -d "$id" --ecc --force 2>&1)" || rc=$?
  # 成没成看 acme.sh 自己的话,不能跑完就说续好了(不是它签的证书、验证没过都会失败)
  case "$out" in
    *"Cert success"*) ok "已强制续期 $name($(cert_summary "$CERT_DIR/$name/fullchain.pem"))" ;;
    *) err "续期失败,acme.sh 的报错(退出码 $rc):"; acme_errors "$out"; return 1 ;;
  esac
}

ssl_remove() {
  need_root
  local name id; name="$(pick_cert_name)" || return 1
  confirm "吊销并删除 $name 的证书(连同自动续期)?" || return 0
  id="$(acme_id_of "$name")"
  if [ -x "$ACME" ] && [ -n "$id" ]; then
    "$ACME" --revoke -d "$id" --ecc >/dev/null 2>&1; "$ACME" --remove -d "$id" --ecc >/dev/null 2>&1
    acme_state_rm "$id"
  fi
  rm -rf "${CERT_DIR:?}/${name:?}"
  if [ "$(env_get TLS_CERT_FILE)" = "$CERT_DIR/$name/fullchain.pem" ]; then ssl_disable; fi
  ok "已删除 $name"
}

ssl_set_paths() {
  need_root
  echo "  1. 用 $CERT_DIR 下已有的证书"
  echo "  2. 自定义证书文件路径(如 certbot 的 /etc/letsencrypt/live/...)"
  local c cf kf name f host guess
  read -r -p "选择:" c
  if [ "$c" = 2 ]; then
    read -r -p "证书(fullchain)路径:" cf; read -r -p "私钥路径:" kf
    [ -f "$cf" ] && [ -f "$kf" ] || { err "文件不存在"; return 1; }
    # 读不到就不往下设:设上去服务起不来
    for f in "$cf" "$kf"; do
      if hidden_from_service "$f"; then
        err "$f 在服务看不到的目录里:systemd 把 /root、/home、/tmp 对 xui-hub 隔离了,改权限也读不到"
        err "把证书和私钥放到别处(比如 /etc/ssl/ 下)再来设"
        return 1
      fi
    done
    # 最小化安装的系统不一定有 sudo,用 runuser(util-linux 自带)
    if command -v runuser >/dev/null && ! runuser -u "$RUN_USER" -- test -r "$cf" -a -r "$kf" 2>/dev/null; then
      err "服务用户 $RUN_USER 读不到这两个文件。先给它读权限(文件 chgrp $RUN_USER 并 chmod 640,上层目录也要它进得去)再来设"
      return 1
    fi
    # 访问用的域名问清楚:一张证书可以签给好几个名字,通配符证书更是猜不出用哪个子域名
    guess="$(cert_host "$cf")"
    read -r -p "访问后台用的域名或 IP${guess:+ [$guess]}:" host
    host="${host:-$guess}"
    [ -n "$host" ] || { err "要填一个证书签给的域名或 IP,证书里的名字:$(cert_names "$cf" | paste -sd' ' -)"; return 1; }
    cert_covers "$cf" "$host" || { err "这张证书没有签给「$host」,证书里的名字:$(cert_names "$cf" | paste -sd' ' -)"; return 1; }
    set_tls "$cf" "$kf" "$host"
    return
  fi
  name="$(pick_cert_name)" || return 1
  use_cert "$CERT_DIR/$name"
}

ssl_disable() {
  need_root
  env_unset TLS_CERT_FILE TLS_KEY_FILE PANEL_HOST
  svc_restart
  # 等服务真的应答了再说成功(重启要一两秒,马上去访问会连不上)
  if wait_up; then ok "已关闭 HTTPS,后台地址 $(panel_url)"; else err "xui-hub 没起来,看日志:xui-hub log"; return 1; fi
}

ssl_menu() {
  echo -e "
  ${green}SSL 证书管理${plain}(acme.sh + Let's Encrypt,证书放在 $CERT_DIR)
  ${green}1.${plain} 申请域名证书(HTTP-01,需要 80 端口能从公网访问)
  ${green}2.${plain} 申请 IP 证书(6 天有效,自动续期)
  ${green}3.${plain} 用 Cloudflare DNS 申请域名证书(含通配符,不需要开 80)
  ${green}4.${plain} 查看已有证书
  ${green}5.${plain} 强制续期
  ${green}6.${plain} 吊销并删除
  ${green}7.${plain} 给 xui-hub 设置证书路径
  ${green}8.${plain} 关闭 HTTPS
  ${green}0.${plain} 返回"
  local c
  read -r -p "请选择 [0-8]:" c
  case "$c" in
    0) return ;;
    1) ssl_issue_domain ;;
    2) ssl_issue_ip ;;
    3) ssl_issue_cf ;;
    4) ssl_list ;;
    5) ssl_renew ;;
    6) ssl_remove ;;
    7) ssl_set_paths ;;
    8) ssl_disable ;;
    *) err "没有这个选项" ;;
  esac
}

ssl_cmd() {
  case "${1:-}" in
    "") ssl_menu ;;
    ip) ssl_issue_ip "${2:-}" ;;
    domain) ssl_issue_domain "${2:-}" ;;
    cf) ssl_issue_cf "${2:-}" ;;
    list) ssl_list ;;
    renew) ssl_renew ;;
    remove) ssl_remove ;;
    use) ssl_set_paths ;;
    off) ssl_disable ;;
    *) echo "用法:xui-hub ssl [ip [IP] | domain <域名> | cf <域名> | list | renew | remove | use | off]"; return 1 ;;
  esac
}

show_status() {
  if ! installed; then warn "状态:未安装"; return; fi
  if systemctl is-active -q "$SERVICE"; then ok "状态:运行中($(version),端口 $(port))"; else err "状态:未运行"; fi
  systemctl is-active -q "$SERVICE-subconverter" 2>/dev/null || warn "订阅转换引擎(subconverter)未运行,Clash / Surge 格式的订阅不可用:xui-hub restart"
  if systemctl is-enabled -q "$SERVICE" 2>/dev/null; then echo "开机自启:是"; else echo "开机自启:否"; fi
}

show_menu() {
  # 菜单里的操作几乎都要 root,而且不是 root 连 .env 都读不到,显示的端口 / 状态会是错的
  need_root
  echo -e "
╔══════════════════════════════════════════╗
║  ${green}xui-hub 管理脚本${plain}                         ║
║  ${green}0.${plain} 退出                                  ║
║──────────────────────────────────────────║
║  ${green}1.${plain} 安装 / 重装                           ║
║  ${green}2.${plain} 更新到最新版                          ║
║  ${green}3.${plain} 卸载                                  ║
║──────────────────────────────────────────║
║  ${green}4.${plain} 重设后台密码                          ║
║  ${green}5.${plain} 改后台端口                            ║
║  ${green}6.${plain} 查看当前设置                          ║
║──────────────────────────────────────────║
║  ${green}7.${plain} 启动          ${green}8.${plain} 停止          ${green}9.${plain} 重启  ║
║  ${green}10.${plain} 运行状态     ${green}11.${plain} 查看日志            ║
║  ${green}12.${plain} 开机自启     ${green}13.${plain} 取消自启            ║
║──────────────────────────────────────────║
║  ${green}14.${plain} SSL 证书管理(HTTPS)                   ║
║  ${green}15.${plain} 备份数据库   ${green}16.${plain} 恢复备份            ║
╚══════════════════════════════════════════╝"
  show_status
  echo
  local num
  read -r -p "请选择 [0-16]:" num
  case "$num" in
    0) exit 0 ;;
    1) install ;;
    2) update ;;
    3) uninstall ;;
    4) password ;;
    5) set_port ;;
    6) settings ;;
    7) svc start ;;
    8) svc stop ;;
    9) svc restart ;;
    10) systemctl status "$SERVICE" --no-pager ;;
    11) journalctl -u "$SERVICE" -f -n 100 ;;
    12) svc enable ;;
    13) svc disable ;;
    14) ssl_menu ;;
    15) backup ;;
    16) local f; read -r -p "备份文件路径:" f; restore "$f" ;;
    *) err "没有这个选项" ;;
  esac
}

case "${1:-}" in
  "") show_menu ;;
  install) install "${2:-}" ;;
  update) update "${2:-}" ;;
  uninstall) uninstall ;;
  password) password ;;
  port) set_port ;;
  settings) settings ;;
  # 下面两个是给 install.sh 用的,逻辑只在这里留一份(install.sh 永远是 main 上的,这个脚本跟着发布包走):
  #   address 打印后台地址;sync-unit 按当前端口加上或去掉绑低端口的 drop-in
  address) need_root; panel_url ;;
  sync-unit) need_root; sync_port_cap ;;
  ssl) shift; ssl_cmd "$@" ;;
  backup) backup "${2:-}" ;;
  restore) restore "${2:-}" ;;
  start | stop | restart | enable | disable) svc "$1" ;;
  status) systemctl status "$SERVICE" --no-pager ;;
  log | logs) journalctl -u "$SERVICE" -f -n 100 ;;
  *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
