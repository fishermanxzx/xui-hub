{
  "name": "xui-hub-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "backup": "tsx src/backup.ts",
    "check-nodes": "tsx src/checkNodes.ts",
    "build": "esbuild src/index.ts src/backup.ts src/checkNodes.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^4.21.2",
    "undici": "^6.21.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
