# 复制为 .env 并修改。.env 不要提交到 git。

# 后台登录密码(必须设置)。带 $、#、空格这类字符时用单引号包起来:ADMIN_PASSWORD='p@ss $word'
ADMIN_PASSWORD=change-me

# 宿主机上监听的地址和端口,默认 0.0.0.0:8788,即直接用 http://<服务器 IP>:8788 访问后台。
# 前面自己放反代(Caddy / Nginx)时改成 LISTEN_ADDR=127.0.0.1 只绑本机
# LISTEN_ADDR=0.0.0.0
# HOST_PORT=8788

# 多久同步一次各面板(连通性、客户端流量)并执行额度 / 到期(秒)
# CHECK_INTERVAL_SEC=60

# 订阅链接的地址前缀。不填 = 用打开后台时的地址(如 http://<服务器 IP>:8788);订阅走单独域名时填它
# SUB_BASE_URL=

# Clash 输出补 Mihomo 基础模板(dns / tcp-concurrent / unified-delay)的范围:all、逗号分隔的客户名(灰度),空 = 关闭
# MIHOMO_TEMPLATE=all

# 订阅拉取记录保留天数
# SUB_LOG_DAYS=7

# HTTPS:两项都填就用这对证书直接提供 HTTPS。一键脚本用 `xui-hub ssl` 申请证书时会自动写好;
# Docker 方式把证书目录挂进容器(compose 里 volumes 加 ./cert:/cert:ro)再填容器内路径
# TLS_CERT_FILE=/cert/fullchain.pem
# TLS_KEY_FILE=/cert/privkey.pem
